    private void btnAgregarActionPerformed(java.awt.event.ActionEvent evt) {                                           
       System.out.println("Caja Producto: " + txtIdProducto.getText() + " | Caja Sucursal: " + txtIdSucursal.getText());
        // TODO add your handling code here:
        if (txtIdProducto.getText().trim().isEmpty() || txtCantidad.getText().trim().isEmpty() || txtPrecioUnitario.getText().trim().isEmpty()) {
    javax.swing.JOptionPane.showMessageDialog(this, "Digita el ID del producto, cantidad y precio.");
    return;
}

try {
    int idProd = Integer.parseInt(txtIdProducto.getText().trim());
    int cant = Integer.parseInt(txtCantidad.getText().trim());
    double precio = Double.parseDouble(txtPrecioUnitario.getText().trim());
    double subtotal = cant * precio;

  
    Object[] fila = new Object[4];
    fila[0] = idProd;
    fila[1] = cant;
    fila[2] = precio;
    fila[3] = subtotal;

  
    modeloCarrito.addRow(fila);


    calcularTotalFactura();


    txtIdProducto.setText("");
    txtCantidad.setText("");
    txtPrecioUnitario.setText("");
    txtIdProducto.requestFocus();

} catch (NumberFormatException e) {
    javax.swing.JOptionPane.showMessageDialog(this, "Verifica que los datos numéricos sean correctos.");
}
    }                                          

    private void btnQuitarActionPerformed(java.awt.event.ActionEvent evt) {                                          
        // TODO add your handling code here:
        int filaSeleccionada = tablaCarrito.getSelectedRow();
if (filaSeleccionada >= 0) {

    modeloCarrito.removeRow(filaSeleccionada);
 
    calcularTotalFactura();
} else {
    javax.swing.JOptionPane.showMessageDialog(this, "Selecciona un producto de la tabla para quitarlo del carrito.");
}
    }                                         

    private void btnFacturarActionPerformed(java.awt.event.ActionEvent evt) {                                            
        // TODO add your handling code here:
        if (txtIdEmpleado.getText().trim().isEmpty() || txtIdSucursal.getText().trim().isEmpty()) {
    javax.swing.JOptionPane.showMessageDialog(this, "ID de Empleado y Sucursal son obligatorios para la factura.");
    return;
}

if (tablaCarrito.getRowCount() == 0) {
    javax.swing.JOptionPane.showMessageDialog(this, "El carrito de compras está vacío. Agrega productos primero.");
    return;
}

try {

    com.elahorro.modelo.Venta v = new com.elahorro.modelo.Venta();
    

    if (txtIdCliente.getText().trim().isEmpty()) {
        v.setIdCliente(0);
    } else {
        v.setIdCliente(Integer.parseInt(txtIdCliente.getText().trim()));
    }
    v.setIdEmpleado(Integer.parseInt(txtIdEmpleado.getText().trim()));
    v.setIdSucursal(Integer.parseInt(txtIdSucursal.getText().trim()));


    java.util.List<com.elahorro.modelo.DetalleVenta> listaDetalles = new java.util.ArrayList<>();
    
    for (int i = 0; i < tablaCarrito.getRowCount(); i++) {
        com.elahorro.modelo.DetalleVenta d = new com.elahorro.modelo.DetalleVenta();
        d.setIdProducto(Integer.parseInt(tablaCarrito.getValueAt(i, 0).toString()));
        d.setCantidad(Integer.parseInt(tablaCarrito.getValueAt(i, 1).toString()));
        d.setPrecioUnitario(Double.parseDouble(tablaCarrito.getValueAt(i, 2).toString()));
        listaDetalles.add(d);
    }


    if (ventaDAO.registrarVentaCompleta(v, listaDetalles)) {
        javax.swing.JOptionPane.showMessageDialog(this, "¡Venta procesada con éxito! Inventario actualizado.");
        

        modeloCarrito.setRowCount(0);
        txtIdCliente.setText("");
        txtIdEmpleado.setText("");
        txtIdSucursal.setText("");
        lblTotal.setText("0.00");
    } else {
        javax.swing.JOptionPane.showMessageDialog(this, "Error crítico al procesar la venta.\nVerifica:\n1. Que los IDs existan.\n2. Que haya suficiente STOCK en la base de datos.");
    }

} catch (NumberFormatException e) {
    javax.swing.JOptionPane.showMessageDialog(this, "Error en el formato de los IDs ingresados.");
}
    }                                           
private void calcularTotalFactura() {
    double total = 0;

    for (int i = 0; i < tablaCarrito.getRowCount(); i++) {
        total += Double.parseDouble(tablaCarrito.getValueAt(i, 3).toString());
    }

    lblTotal.setText(String.valueOf(total));
}

