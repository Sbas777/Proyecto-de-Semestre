DATABASE UNIVERSIDAD
-- CREATE DATABASE administracion_academica;
-- \c administracion_academica;

CREATE TABLE decano (
    id_decano BIGINT DEFAULT trunc(random() * 89999999 + 10000000)::bigint PRIMARY KEY,
    documento_identidad VARCHAR(20) UNIQUE NOT NULL,
    nombre VARCHAR(100) NOT NULL,
    apellido VARCHAR(100) NOT NULL,
    correo VARCHAR(150) UNIQUE NOT NULL
);
CREATE TABLE asignatura (
    id_asignatura BIGINT DEFAULT trunc(random() * 89999999 + 10000000)::bigint PRIMARY KEY,
    codigo VARCHAR(20) UNIQUE NOT NULL,
    nombre VARCHAR(150) NOT NULL,
    creditos INT NOT NULL CHECK (creditos > 0)
);

CREATE TABLE facultad (
    id_facultad BIGINT DEFAULT trunc(random() * 89999999 + 10000000)::bigint PRIMARY KEY,
    nombre VARCHAR(150) UNIQUE NOT NULL,
    id_decano BIGINT UNIQUE NOT NULL, -- Garantiza cardinalidad 1:1
    CONSTRAINT fk_facultad_decano FOREIGN KEY (id_decano) 
        REFERENCES decano(id_decano) ON DELETE RESTRICT
);

CREATE TABLE programa (
    id_programa BIGINT DEFAULT trunc(random() * 89999999 + 10000000)::bigint PRIMARY KEY,
    nombre VARCHAR(150) UNIQUE NOT NULL,
    id_facultad BIGINT NOT NULL,
    CONSTRAINT fk_programa_facultad FOREIGN KEY (id_facultad) 
        REFERENCES facultad(id_facultad) ON DELETE RESTRICT
);


CREATE TABLE profesor (
    id_profesor BIGINT DEFAULT trunc(random() * 89999999 + 10000000)::bigint PRIMARY KEY,
    documento_identidad VARCHAR(20) UNIQUE NOT NULL,
    nombre VARCHAR(100) NOT NULL,
    apellido VARCHAR(100) NOT NULL,
    correo VARCHAR(150) UNIQUE NOT NULL,
    id_programa BIGINT NOT NULL, 
    CONSTRAINT fk_profesor_programa FOREIGN KEY (id_programa) 
        REFERENCES programa(id_programa) ON DELETE RESTRICT
);

CREATE TABLE estudiante (
    id_estudiante BIGINT DEFAULT trunc(random() * 89999999 + 10000000)::bigint PRIMARY KEY,
    documento_identidad VARCHAR(20) UNIQUE NOT NULL,
    nombre VARCHAR(100) NOT NULL,
    apellido VARCHAR(100) NOT NULL,
    correo VARCHAR(150) UNIQUE NOT NULL,
    id_programa BIGINT NOT NULL,
    CONSTRAINT fk_estudiante_programa FOREIGN KEY (id_programa) 
        REFERENCES programa(id_programa) ON DELETE RESTRICT
);


CREATE TABLE plan_estudio (
    id_programa BIGINT NOT NULL,
    id_asignatura BIGINT NOT NULL,
    semestre_sugerido INT NOT NULL CHECK (semestre_sugerido > 0),
    PRIMARY KEY (id_programa, id_asignatura),
    CONSTRAINT fk_plan_programa FOREIGN KEY (id_programa) 
        REFERENCES programa(id_programa) ON DELETE CASCADE,
    CONSTRAINT fk_plan_asignatura FOREIGN KEY (id_asignatura) 
        REFERENCES asignatura(id_asignatura) ON DELETE CASCADE
);


CREATE TABLE grupo (
    id_grupo BIGINT DEFAULT trunc(random() * 89999999 + 10000000)::bigint PRIMARY KEY,
    numero_grupo INT NOT NULL CHECK (numero_grupo > 0),
    semestre_academico VARCHAR(10) NOT NULL, 
    dia_semana VARCHAR(15) NOT NULL CHECK (dia_semana IN ('Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado')),
    hora_inicio TIME NOT NULL,
    hora_fin TIME NOT NULL,
    id_asignatura BIGINT NOT NULL,
    id_profesor BIGINT NOT NULL,
    CONSTRAINT ck_rango_horas CHECK (hora_inicio < hora_fin),
    CONSTRAINT uq_grupo_semestre UNIQUE (numero_grupo, id_asignatura, semestre_academico), 
    CONSTRAINT fk_grupo_asignatura FOREIGN KEY (id_asignatura) 
        REFERENCES asignatura(id_asignatura) ON DELETE RESTRICT,
    CONSTRAINT fk_grupo_profesor FOREIGN KEY (id_profesor) 
        REFERENCES profesor(id_profesor) ON DELETE RESTRICT
);

CREATE TABLE matricula (
    id_estudiante BIGINT NOT NULL,
    id_grupo BIGINT NOT NULL,
    nota_final NUMERIC(3,2) DEFAULT NULL, 
    fecha_matricula TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (id_estudiante, id_grupo),
    CONSTRAINT ck_nota_rango CHECK (nota_final IS NULL OR (nota_final >= 0.00 AND nota_final <= 5.00)),
    CONSTRAINT fk_matricula_estudiante FOREIGN KEY (id_estudiante) 
        REFERENCES estudiante(id_estudiante) ON DELETE CASCADE,
    CONSTRAINT fk_matricula_grupo FOREIGN KEY (id_grupo) 
        REFERENCES grupo(id_grupo) ON DELETE RESTRICT
);
