    private void btnGuardarActionPerformed(java.awt.event.ActionEvent evt) {                                           
        // TODO add your handling code here:
        if (txtNombre.getText().trim().isEmpty() || txtPrecio.getText().trim().isEmpty() || txtStock.getText().trim().isEmpty() || txtCategoria.getText().trim().isEmpty()) {
    javax.swing.JOptionPane.showMessageDialog(this, "Todos los campos son obligatorios.");
    return;
}

try {
    com.elahorro.modelo.Producto p = new com.elahorro.modelo.Producto();
    p.setNombre(txtNombre.getText().trim());
    p.setPrecioActual(Double.parseDouble(txtPrecio.getText().trim()));
    p.setStockActual(Integer.parseInt(txtStock.getText().trim()));
    p.setIdCategoria(Integer.parseInt(txtCategoria.getText().trim())); 

    if (productoDAO.registrarProducto(p)) {
        javax.swing.JOptionPane.showMessageDialog(this, "¡Producto registrado exitosamente!");
        listarProductosEnTabla();
        limpiarCampos();
    } else {
        javax.swing.JOptionPane.showMessageDialog(this, "Error al registrar el producto. Verifica que el ID de la categoría exista.");
    }
} catch (NumberFormatException e) {
    javax.swing.JOptionPane.showMessageDialog(this, "El precio debe ser un número decimal y el stock/categoría deben ser números enteros.");
}
    }                                          

    private void btnEditarActionPerformed(java.awt.event.ActionEvent evt) {                                          
        // TODO add your handling code here:
        int fila = tablaProductos.getSelectedRow();
if (fila < 0) {
    javax.swing.JOptionPane.showMessageDialog(this, "Por favor, seleccione un producto de la tabla para modificar.");
    return;
}

try {
    com.elahorro.modelo.Producto p = new com.elahorro.modelo.Producto();

    p.setIdProducto(Integer.parseInt(tablaProductos.getValueAt(fila, 0).toString()));
    p.setNombre(txtNombre.getText().trim());
    p.setPrecioActual(Double.parseDouble(txtPrecio.getText().trim()));
    p.setStockActual(Integer.parseInt(txtStock.getText().trim()));
    p.setIdCategoria(Integer.parseInt(txtCategoria.getText().trim()));

    if (productoDAO.actualizarProducto(p)) {
        javax.swing.JOptionPane.showMessageDialog(this, "¡Producto actualizado con éxito!");
        listarProductosEnTabla();
        limpiarCampos();
    } else {
        javax.swing.JOptionPane.showMessageDialog(this, "Error al actualizar. Verifica los datos o la categoría.");
    }
} catch (NumberFormatException e) {
    javax.swing.JOptionPane.showMessageDialog(this, "Verifica el formato de los números ingresados.");
}
    }                                         

    private void btnEliminarActionPerformed(java.awt.event.ActionEvent evt) {                                            
        // TODO add your handling code here:
        int fila = tablaProductos.getSelectedRow();
if (fila < 0) {
    javax.swing.JOptionPane.showMessageDialog(this, "Seleccione un producto de la tabla para eliminar.");
    return;
}

int id = Integer.parseInt(tablaProductos.getValueAt(fila, 0).toString());
String nombre = tablaProductos.getValueAt(fila, 1).toString();

int confirmar = javax.swing.JOptionPane.showConfirmDialog(this, 
        "¿Está seguro de eliminar el producto: " + nombre + "?", 
        "Confirmar eliminación", javax.swing.JOptionPane.YES_NO_OPTION);

if (confirmar == javax.swing.JOptionPane.YES_OPTION) {
    if (productoDAO.eliminarProducto(id)) {
        javax.swing.JOptionPane.showMessageDialog(this, "Producto eliminado.");
        listarProductosEnTabla();
        limpiarCampos();
    } else {
        javax.swing.JOptionPane.showMessageDialog(this, "No se puede eliminar el producto. Podría estar asociado a una venta (Restricción de integridad).");
    }
}
    }                                           

