    @SuppressWarnings("unchecked")
    private void listarProductosEnTabla() {
    javax.swing.table.DefaultTableModel modelo = (javax.swing.table.DefaultTableModel) tablaProductos.getModel();
    modelo.setRowCount(0); 
    
    java.util.List<com.elahorro.modelo.Producto> lista = productoDAO.listarProductos();
    
    for (com.elahorro.modelo.Producto p : lista) {
        Object[] fila = new Object[5];
        fila[0] = p.getIdProducto();   
        fila[1] = p.getNombre();       
        fila[2] = p.getPrecioActual(); 
        fila[3] = p.getStockActual();  
        fila[4] = p.getIdCategoria();  
        
        modelo.addRow(fila);
    }
}
